# Required
TELEGRAM_BOT_TOKEN=your_bot_token_from_@BotFather
TELEGRAM_USER_ID=your_numeric_telegram_user_id   # message @userinfobot to find it

# Your name as it should appear in prompts ("reply in <name>'s voice")
NAVI_USER_NAME=you

# Path to Claude CLI (optional - defaults to ~/.local/bin/claude)
# CLAUDE_PATH=/usr/local/bin/claude
# Model to pin for background agents (optional)
# CLAUDE_MODEL=claude-sonnet-5

# Mobile-mode idle timeout in seconds before a tab is released to the keyboard (optional)
# NAVI_MOBILE_TIMEOUT=900

# OpenAI for voice transcription (optional)
# OPENAI_API_KEY=

# Slack integration (optional)
# SLACK_USER_TOKEN=
# SLACK_WORKSPACE_ID=

# Permissions for background Claude runs (comma-separated --allowedTools patterns).
# Everything else is routed to the Telegram permission hook, or denied without one.
NAVI_EXECUTOR_ALLOWED_TOOLS=Read,Glob,Grep,Edit,Write
NAVI_INBOX_ALLOWED_TOOLS=mcp__gmail__*,Write

# Inbox rules (only used by /inbox fetch and clean)
NAVI_INBOX_RECEIPTS_LABEL=Receipts
NAVI_INBOX_PROTECTED_SENDERS=yourbank.com,yourbroker.com
NAVI_INBOX_PROTECTED_PARTIAL=newsletter-you-actually-read
NAVI_INBOX_FINANCE_SENDERS=paypal,stripe,square,shopify,amazon
