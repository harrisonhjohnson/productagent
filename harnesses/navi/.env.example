# Required
TELEGRAM_BOT_TOKEN=your_bot_token_from_@BotFather
TELEGRAM_USER_ID=your_numeric_telegram_user_id   # message @userinfobot to find it

# Your name as it should appear in prompts ("reply in <name>'s voice")
NAVI_USER_NAME=you

# Path to Claude CLI (optional - defaults to ~/.local/bin/claude)
# CLAUDE_PATH=/usr/local/bin/claude
# Model to pin for background agents (optional)
# CLAUDE_MODEL=claude-sonnet-5

# Mobile-mode idle timeout in seconds before a tab is released to the keyboard (optional)
# NAVI_MOBILE_TIMEOUT=900

# OpenAI for voice transcription (optional)
# OPENAI_API_KEY=

# Slack integration (optional)
# SLACK_USER_TOKEN=
# SLACK_WORKSPACE_ID=
